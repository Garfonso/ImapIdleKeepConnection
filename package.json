{
  "name": "imap-idle-keep-connection",
  "version": "0.4.3",
  "description": "Keep an IMAP IDLE connection alive (imapflow): reconnects with backoff, tells network, authentication and server errors apart and emits mail events.",
  "keywords": [
    "imap",
    "idle",
    "imapflow",
    "reconnect",
    "xoauth2"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "npm run lint && npm run typecheck && node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run build",
    "release": "release-script"
  },
  "author": "Garfonso <garfonso@mobo.info>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Garfonso/ImapIdleKeepConnection.git"
  },
  "dependencies": {
    "imapflow": "^2.11.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^3.5.9",
    "@alcalzone/release-script-plugin-license": "^3.5.9",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
