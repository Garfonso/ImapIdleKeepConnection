{
    "compilerOptions": {
        "target": "es2023",
        "lib": ["es2023"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": ["node"],
        "strict": true,
        "noUnusedLocals": true,
        "noImplicitReturns": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "rewriteRelativeImportExtensions": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["src", "test"]
}
